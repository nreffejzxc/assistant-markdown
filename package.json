{
  "name": "assistant-markdown",
  "version": "0.1.0",
  "description": "A dependency-free Markdown-subset parser for chat UI: blocks, inline styling, tables, and LaTeX decoding \u2014 built so a model's formatting never reaches a screen as punctuation.",
  "type": "module",
  "exports": {
    ".": "./src/assistantMarkdown.ts"
  },
  "types": "./src/assistantMarkdown.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test test/",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "keywords": [
    "markdown",
    "chat",
    "llm",
    "assistant",
    "latex",
    "parser",
    "typescript",
    "dependency-free"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
